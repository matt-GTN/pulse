# Edit this file to add/remove sources. No redeploy needed —
# the pipeline reads it fresh each run.
#
# Editorial weight (1–3): applied at ranking time as (weight - 1) boost.
#   1 = baseline (mainstream press, broad aggregators)
#   2 = curated / high signal-to-noise
#   3 = top-tier (lab blogs, trusted individual voices)

arxiv:
  enabled: true
  weight: 2
  categories:
    - cs.AI
    - cs.LG
    - cs.CL
  max_results: 50

reddit:
  enabled: false  # requires OAuth app registration — datacenter IPs blocked without it
  sort: hot
  limit: 30
  weight: 1  # default for any sub not in `weights`
  weights:
    MachineLearning: 2
    LocalLLaMA: 2        # open-source releases land here first
    singularity: 1
    OpenAI: 1
  subreddits:
    - MachineLearning
    - LocalLLaMA
    - singularity
    - OpenAI

hackernews:
  enabled: true
  weight: 2  # curated by upvotes, decent signal
  query: "AI OR LLM OR GPT OR transformer OR neural network"
  min_points: 20
  limit: 30

rss:
  enabled: true
  default_weight: 1
  feeds:
    # ── Lab blogs (tier 3) ────────────────────────────────────────────────
    - name: OpenAI
      url: https://openai.com/news/rss.xml
      weight: 3
    - name: Google DeepMind
      url: https://deepmind.google/blog/rss.xml
      weight: 3
    - name: Google Research
      url: https://research.google/blog/rss/
      weight: 3
    - name: Microsoft Research
      url: https://www.microsoft.com/en-us/research/feed/
      weight: 3
    - name: Hugging Face Blog
      url: https://huggingface.co/blog/feed.xml
      weight: 3

    # ── Research aggregators (tier 3) ────────────────────────────────────
    - name: Papers With Code
      url: https://paperswithcode.com/latest.rss
      weight: 3
    - name: The Gradient
      url: https://thegradient.pub/rss/
      weight: 3

    # ── Trusted individual voices (tier 3) ────────────────────────────────
    - name: Simon Willison
      url: https://simonwillison.net/atom/everything/
      weight: 3
    - name: Karpathy
      url: https://karpathy.github.io/feed.xml
      weight: 3
    - name: Interconnects (Nathan Lambert)
      url: https://www.interconnects.ai/feed
      weight: 3
    - name: Import AI (Jack Clark)
      url: https://importai.substack.com/feed
      weight: 3
    - name: Latent Space
      url: https://www.latent.space/feed
      weight: 2

    # ── Analysis & policy (tier 2) ────────────────────────────────────────
    - name: MIT Technology Review AI
      url: https://www.technologyreview.com/topic/artificial-intelligence/feed
      weight: 2
    - name: Stratechery
      url: https://stratechery.com/feed/
      weight: 2
    - name: Platformer
      url: https://www.platformer.news/feed
      weight: 2
    - name: Lobsters AI
      url: https://lobste.rs/t/ai.rss
      weight: 2

    # ── Business / econ / political (tier 1–2) ────────────────────────────
    - name: TechCrunch AI
      url: https://techcrunch.com/category/artificial-intelligence/feed/
      weight: 1
    - name: The Verge AI
      url: https://www.theverge.com/rss/ai-artificial-intelligence/index.xml
      weight: 1
    - name: Ars Technica
      url: https://feeds.arstechnica.com/arstechnica/technology-lab
      weight: 1
anthropic:
  enabled: true
  weight: 3  # top-tier — lab blog, official announcements

# ── Not yet wired (would need custom fetchers or don't expose RSS) ─────────
# - Meta AI blog (https://ai.meta.com/blog/): no public RSS — scrape or skip
# - Axios Technology: RSS endpoints return 403/404 — needs their API or scraping
# - GitHub Trending (daily): no native RSS, needs scraping or github-trending-api
# - Hugging Face Papers: no official RSS; community mirrors exist but unstable
# - Twitter/X: fragile scraping, paid API — LocalLLaMA + HN cover most of it
# - Mistral news: no confirmed RSS endpoint as of writing
# - DeepSeek / Moonshot / Qwen: follow via GitHub releases or HF model uploads
